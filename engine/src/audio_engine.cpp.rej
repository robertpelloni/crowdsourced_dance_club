+    if (!dmx.initialize()) {
+        printf("[WARNING] DMX Hardware failed to initialize.\n");
+    }

     return true;
 }
@@ -49,6 +54,7 @@
         printf("PortAudio Stop Error: %s\n", Pa_GetErrorText(err));
     }
     Pa_Terminate();
+    dmx.stop();
 }

